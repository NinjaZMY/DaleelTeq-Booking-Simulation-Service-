# ===========================
# Environment Template File
# ===========================
# This file shows the required environment variables for the application.
# Copy this file to .env and fill in your actual values.
# The .env file is loaded automatically at startup and overrides application.properties values.
# IMPORTANT: Do NOT commit .env to version control. See .gitignore for security rules.

# Database Credentials (PostgreSQL)
DB_USERNAME=booking_user
DB_PASSWORD=changeme

# Database URL (optional, will use default if not set)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/booking_db

# Time Window Configuration (optional, will use defaults if not set)
# APP_TIME_WINDOW_START=09:00
# APP_TIME_WINDOW_END=16:00

# Spring Profile (dev, test, prod)
# SPRING_PROFILES_ACTIVE=dev
