# ===========================
# Git Ignore Rules
# ===========================

# Environment Variables (SECURITY: Never commit actual .env files)
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.iml
*.iws

# Maven
target/
.mvn/
mvnw.cmd

# Build artifacts
*.jar
*.war
*.ear

# Logs
*.log
logs/

# OS
Thumbs.db
.DS_Store

# Node (Frontend)
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/package-lock.json
frontend/yarn.lock

# Angular specific
frontend/dist/
.angular/cache/

# Node general
node_modules/
package-lock.json
yarn.lock


