# ===========================
# Git Ignore Rules
# ===========================

# Environment Variables (SECURITY: Never commit actual .env files)
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
*.iml
*.iws

# Maven
target/
.mvn/
mvnw.cmd

# Build artifacts
*.jar
*.war
*.ear

# Logs
*.log
logs/

# OS
Thumbs.db
.DS_Store

# Node (if using any frontend tools)
node_modules/
package-lock.json
yarn.lock
